{
  "name": "@molecare/health-data",
  "version": "1.0.0",
  "description": "Read steps, sleep, workouts, active energy and water from Apple HealthKit and Google Health Connect through one typed React Native API. Read-only; every read returns a result instead of failing silently.",
  "license": "Apache-2.0",
  "author": "MoleCare LTD <info@molecare.co.uk> (https://www.molecare.co.uk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoleCare/rn-health-data.git"
  },
  "bugs": {
    "url": "https://github.com/MoleCare/rn-health-data/issues"
  },
  "homepage": "https://github.com/MoleCare/rn-health-data#readme",
  "keywords": [
    "react-native",
    "expo",
    "healthkit",
    "health-connect",
    "apple-health",
    "steps",
    "sleep",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!**/__tests__",
    "!**/*.tsbuildinfo",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib coverage",
    "prepack": "bob build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "check:package": "bob build && publint --strict && attw --pack .",
    "check:consumer": "bash scripts/check-consumer.sh"
  },
  "peerDependencies": {
    "react-native": ">=0.70.0",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": ">=3.5.0 <5"
  },
  "peerDependenciesMeta": {
    "react-native-health": {
      "optional": true
    },
    "react-native-health-connect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "babel-jest": "^30.5.1",
    "del-cli": "^7.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "globalSetup": "<rootDir>/jest.global-setup.cjs",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts",
      "!<rootDir>/src/index.ts",
      "!<rootDir>/src/types.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "publishConfig": {
    "access": "public"
  }
}
